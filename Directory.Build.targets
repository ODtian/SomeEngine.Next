<Project>
  <PropertyGroup>
    <SomeEngineQualityAnalyzerProject>$(SomeEngineRepositoryRoot)harness\quality\SomeEngine.Harness.QualityAnalyzer\SomeEngine.Harness.QualityAnalyzer.csproj</SomeEngineQualityAnalyzerProject>
    <SomeEngineQualityAnalyzerEnabled Condition="'$(SomeEngineQualityAnalyzerEnabled)' == ''">false</SomeEngineQualityAnalyzerEnabled>
    <SomeEngineQualityBaselineEnabled Condition="'$(SomeEngineQualityBaselineEnabled)' == ''">true</SomeEngineQualityBaselineEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(SomeEngineQualityAnalyzerEnabled)' == 'true' and '$(SomeEngineQualityAnalyzerOptOut)' != 'true' and $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$([System.IO.Path]::Combine($(SomeEngineRepositoryRoot), `src`))')) == 'true'">
    <ProjectReference Include="$(SomeEngineQualityAnalyzerProject)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishAot"
                      AdditionalProperties="PublishAot=false" />
    <AdditionalFiles Include="$(SomeEngineRepositoryRoot)harness\config.json" />
    <AdditionalFiles Include="$(SomeEngineRepositoryRoot)harness\quality-baselines\graphics-hard-baseline.v1.json"
                     Condition="'$(SomeEngineQualityBaselineEnabled)' == 'true'" />
  </ItemGroup>

  <Target Name="ValidateSlangToolchainIdentity" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(_RequestedSlangToolchainVersion)' != '' and '$(_RequestedSlangToolchainVersion)' != '$(SlangToolchainVersion)'"
           Text="SlangToolchainVersion is pinned by the product and cannot be overridden (requested '$(_RequestedSlangToolchainVersion)', pinned '$(SlangToolchainVersion)')." />
    <Error Condition="'$(SlangToolchainVersion)' == ''"
           Text="SlangToolchainVersion is the required compile-time Slang compatibility authority." />
    <Error Condition="'$(SlangStandardModuleDirectory)' != 'slang-standard-module-$(SlangToolchainVersion)'"
           Text="SlangStandardModuleDirectory must be derived from SlangToolchainVersion." />
    <Error Condition="'$(SlangTestFixtureDirectory)' != 'SlangStandardModule$(SlangToolchainVersion)'"
           Text="SlangTestFixtureDirectory must be derived from SlangToolchainVersion." />
  </Target>
</Project>
