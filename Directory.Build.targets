<Project>
  <ItemGroup>
    <_ViewsReference Include="@(ProjectReference->WithMetadataValue('Filename', 'SomeEngine.Views'))" />
    <_ViewsReference Include="@(ProjectReference->WithMetadataValue('Filename', 'SomeEngine.Views.Compose'))" />
    <ProjectReference Include="$(SomeEngineRepositoryRoot)src/SomeEngine.Views.Generators/SomeEngine.Views.Generators.csproj"
                      Condition="'@(_ViewsReference)' != ''"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" GlobalPropertiesToRemove="PublishAot" />
  </ItemGroup>
  <Target Name="ValidateSlangToolchainIdentity" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectName)' == 'SomeEngine.Graphics' or '$(MSBuildProjectName)' == 'SomeEngine.Graphics.Direct3D12.Tests'">
    <Error Condition="'$(_RequestedSlangToolchainVersion)' != '' and '$(_RequestedSlangToolchainVersion)' != '$(SlangToolchainVersion)'"
           Text="SlangToolchainVersion is pinned by the product and cannot be overridden (requested '$(_RequestedSlangToolchainVersion)', pinned '$(SlangToolchainVersion)')." />
    <Error Condition="'$(SlangToolchainVersion)' == ''"
           Text="SlangToolchainVersion is the required compile-time Slang compatibility authority." />
    <Error Condition="'$(SlangStandardModuleDirectory)' != 'slang-standard-module-$(SlangToolchainVersion)'"
           Text="SlangStandardModuleDirectory must be derived from SlangToolchainVersion." />
    <Error Condition="'$(SlangTestFixtureDirectory)' != 'SlangStandardModule$(SlangToolchainVersion)'"
           Text="SlangTestFixtureDirectory must be derived from SlangToolchainVersion." />
  </Target>
</Project>
