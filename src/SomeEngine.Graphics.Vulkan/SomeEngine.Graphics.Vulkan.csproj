<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SomeEngineQualityAnalyzerEnabled>true</SomeEngineQualityAnalyzerEnabled>
    <SomeEngineQualityBaselineEnabled>false</SomeEngineQualityBaselineEnabled>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Vulkan Graphics backend adapter.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SomeEngine.Graphics/SomeEngine.Graphics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.NV" Version="2.23.0" />
  </ItemGroup>
</Project>
