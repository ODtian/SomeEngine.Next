<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <ProjectReference Include="..\SomeEngine.Assets\SomeEngine.Assets.csproj" />
    <ProjectReference Include="..\..\external\Alimer.Bindings\src\Alimer.Bindings.MeshOptimizer\Alimer.Bindings.MeshOptimizer.csproj" />
    <ProjectReference Include="..\..\external\SlangShaderSharp\src\SlangShaderSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\external\SlangShaderSharp\runtimes\**">
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\win-x64\native\slang-compiler.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>slang-compiler.dll</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\win-arm64\native\slang-compiler.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
      <Link>slang-compiler.dll</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\linux-x64\native\libslang-compiler.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
      <Link>libslang-compiler.so</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\linux-arm64\native\libslang-compiler.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
      <Link>libslang-compiler.so</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\osx-x64\native\libslang-compiler.dylib"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">
      <Link>libslang-compiler.dylib</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\osx-arm64\native\libslang-compiler.dylib"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">
      <Link>libslang-compiler.dylib</Link>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\win-x64\meshoptimizer.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>meshoptimizer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\win-arm64\meshoptimizer.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
      <Link>meshoptimizer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\linux-x64\libmeshoptimizer.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
      <Link>libmeshoptimizer.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\linux-arm64\libmeshoptimizer.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
      <Link>libmeshoptimizer.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\osx\libmeshoptimizer.dylib"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64' Or '$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">
      <Link>libmeshoptimizer.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
