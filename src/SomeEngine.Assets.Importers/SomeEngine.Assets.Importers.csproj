<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <MetisRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../external/metis'))</MetisRoot>
    <MetisLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">metis.dll</MetisLibrary>
    <MetisLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">libmetis.so</MetisLibrary>
    <MetisLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmetis.dylib</MetisLibrary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <ProjectReference Include="..\SomeEngine.Assets\SomeEngine.Assets.csproj" />
    <ProjectReference Include="..\SomeEngine.Core\SomeEngine.Core.csproj" />
    <ProjectReference Include="..\SomeEngine.Render\SomeEngine.Render.csproj" />
    <ProjectReference Include="..\SomeEngine.Generators\SomeEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\external\Alimer.Bindings\src\Alimer.Bindings.MeshOptimizer\Alimer.Bindings.MeshOptimizer.csproj" />
    <PackageReference Include="SlangShaderSharp" Version="$(SlangShaderSharpPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\external\Alimer.Bindings\native\win-x64\meshoptimizer.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>meshoptimizer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\win-arm64\meshoptimizer.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
      <Link>meshoptimizer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\linux-x64\libmeshoptimizer.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
      <Link>libmeshoptimizer.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\linux-arm64\libmeshoptimizer.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
      <Link>libmeshoptimizer.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\osx\libmeshoptimizer.dylib"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64' Or '$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">
      <Link>libmeshoptimizer.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <MetisSource Include="$(MetisRoot)/**/*.c;$(MetisRoot)/**/*.h;$(MetisRoot)/CMakeLists.txt"
                 Exclude="$(MetisRoot)/build/**" />
    <Content Include="$(MetisRoot)/native/$(NETCoreSdkRuntimeIdentifier)/$(MetisLibrary)"
             Link="$(MetisLibrary)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMetis" BeforeTargets="AssignTargetPaths"
          Inputs="@(MetisSource)" Outputs="$(MetisRoot)/native/$(NETCoreSdkRuntimeIdentifier)/$(MetisLibrary)">
    <Exec Command="cmake -S &quot;$(MetisRoot)&quot; -B &quot;$(MetisRoot)/build/$(NETCoreSdkRuntimeIdentifier)&quot; -DCMAKE_BUILD_TYPE=Release -DCMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE=&quot;$(MetisRoot)/native/$(NETCoreSdkRuntimeIdentifier)&quot; -DCMAKE_LIBRARY_OUTPUT_DIRECTORY=&quot;$(MetisRoot)/native/$(NETCoreSdkRuntimeIdentifier)&quot;" />
    <Exec Command="cmake --build &quot;$(MetisRoot)/build/$(NETCoreSdkRuntimeIdentifier)&quot; --config Release --parallel" />
  </Target>
</Project>
