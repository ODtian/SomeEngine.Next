<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Immediate render-graph recording, transparent compilation reuse, and deterministic execution.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SomeEngine.Graphics/SomeEngine.Graphics.csproj" />
    <ProjectReference Include="../SomeEngine.Job/SomeEngine.Job.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Authoring/**/*.cs" />
    <Compile Include="Recording/**/*.cs" />
    <Compile Include="Compilation/**/*.cs" />
    <Compile Include="Execution/**/*.cs" />
    <Compile Include="Diagnostics/**/*.cs" />
    <Compile Include="Internal/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SomeEngine.RenderGraph.Tests" />
  </ItemGroup>
</Project>
