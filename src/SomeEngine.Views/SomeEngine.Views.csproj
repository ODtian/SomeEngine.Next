<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Struct views backed by ECS components, generated view functions, and call-site node identities.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SomeEngine.Layout" />
    <ProjectReference Include="../SomeEngine.ECS/SomeEngine.ECS.csproj" />
    <ProjectReference Include="../SomeEngine.ECS.Systems/SomeEngine.ECS.Systems.csproj" />
    <ProjectReference Include="../SomeEngine.Job/SomeEngine.Job.csproj" />
    <ProjectReference Include="../SomeEngine.Core/SomeEngine.Core.csproj" />
    <ProjectReference Include="../SomeEngine.Views.Generators/SomeEngine.Views.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" GlobalPropertiesToRemove="PublishAot" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../SomeEngine.Views.Generators/bin/$(Configuration)/netstandard2.0/SomeEngine.Views.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Update="buildTransitive/SomeEngine.Views.props" Pack="true" PackagePath="buildTransitive/SomeEngine.Views.props" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
