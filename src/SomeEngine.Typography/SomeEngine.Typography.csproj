<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TypographyRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</TypographyRid>
    <TypographyRid Condition="'$(TypographyRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</TypographyRid>
    <TypographyNativeRoot>$(MSBuildThisFileDirectory)../../external/Typography</TypographyNativeRoot>
    <TypographyLibraryPrefix Condition="$([System.String]::Copy('$(TypographyRid)').StartsWith('linux')) or $([System.String]::Copy('$(TypographyRid)').StartsWith('osx'))">lib</TypographyLibraryPrefix>
    <TypographyLibraryExtension Condition="$([System.String]::Copy('$(TypographyRid)').StartsWith('win'))">dll</TypographyLibraryExtension>
    <TypographyLibraryExtension Condition="$([System.String]::Copy('$(TypographyRid)').StartsWith('linux'))">so</TypographyLibraryExtension>
    <TypographyLibraryExtension Condition="$([System.String]::Copy('$(TypographyRid)').StartsWith('osx'))">dylib</TypographyLibraryExtension>
    <TypographyCmakeArchitecture Condition="$([System.String]::Copy('$(TypographyRid)').StartsWith('win')) and $([System.String]::Copy('$(TypographyRid)').EndsWith('x64'))">-A x64</TypographyCmakeArchitecture>
    <TypographyCmakeArchitecture Condition="$([System.String]::Copy('$(TypographyRid)').StartsWith('win')) and $([System.String]::Copy('$(TypographyRid)').EndsWith('arm64'))">-A ARM64</TypographyCmakeArchitecture>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SomeEngine.Core/SomeEngine.Core.csproj" />
    <Content Include="$(TypographyNativeRoot)/bin/$(TypographyRid)/$(TypographyLibraryPrefix)freetype.$(TypographyLibraryExtension);$(TypographyNativeRoot)/bin/$(TypographyRid)/$(TypographyLibraryPrefix)harfbuzz.$(TypographyLibraryExtension)"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TypographyNativeRoot)/bin/$(TypographyRid)/FreeType-LICENSE.txt;$(TypographyNativeRoot)/bin/$(TypographyRid)/HarfBuzz-LICENSE.txt"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildTypographyLibraries" BeforeTargets="PrepareForBuild"
          Inputs="$(TypographyNativeRoot)/CMakeLists.txt"
          Outputs="$(TypographyNativeRoot)/bin/$(TypographyRid)/$(TypographyLibraryPrefix)freetype.$(TypographyLibraryExtension);$(TypographyNativeRoot)/bin/$(TypographyRid)/$(TypographyLibraryPrefix)harfbuzz.$(TypographyLibraryExtension);$(TypographyNativeRoot)/bin/$(TypographyRid)/FreeType-LICENSE.txt;$(TypographyNativeRoot)/bin/$(TypographyRid)/HarfBuzz-LICENSE.txt">
    <Exec Command="cmake -S &quot;$(TypographyNativeRoot)&quot; -B &quot;$(TypographyNativeRoot)/obj/$(TypographyRid)&quot; $(TypographyCmakeArchitecture) -DTYPOGRAPHY_RID=$(TypographyRid) -DCMAKE_BUILD_TYPE=Release" />
    <Exec Command="cmake --build &quot;$(TypographyNativeRoot)/obj/$(TypographyRid)&quot; --config Release --parallel" />
  </Target>
</Project>
