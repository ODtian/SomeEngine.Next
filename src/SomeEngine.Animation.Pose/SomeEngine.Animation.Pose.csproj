<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AclRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</AclRid>
    <AclRid Condition="'$(AclRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</AclRid>
    <AclPrefix Condition="$([System.String]::Copy('$(AclRid)').StartsWith('linux'))">lib</AclPrefix>
    <AclExtension Condition="$([System.String]::Copy('$(AclRid)').StartsWith('win'))">dll</AclExtension>
    <AclExtension Condition="$([System.String]::Copy('$(AclRid)').StartsWith('linux'))">so</AclExtension>
    <AclArchitecture Condition="$([System.String]::Copy('$(AclRid)').StartsWith('win'))">-A x64</AclArchitecture>
    <AclOutput>$(MSBuildProjectDirectory)/obj/native/$(AclRid)/Release/$(AclPrefix)SomeEngineAcl.$(AclExtension)</AclOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SomeEngine.Animation/SomeEngine.Animation.csproj" />
    <ProjectReference Include="../SomeEngine.Assets/SomeEngine.Assets.csproj" />
    <ProjectReference Include="../SomeEngine.Core/SomeEngine.Core.csproj" />
    <ProjectReference Include="../SomeEngine.Physics/SomeEngine.Physics.csproj" />
    <ProjectReference Include="../SomeEngine.Generators/SomeEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AclNativeSource Include="Native/**/*;../../external/acl/includes/**/*;../../external/rtm/includes/**/*" />
    <Content Include="$(AclOutput)"
             Link="$(AclPrefix)SomeEngineAcl.$(AclExtension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../external/acl/LICENSE" Link="licenses/ACL-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../external/rtm/LICENSE" Link="licenses/RTM-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildAclNative" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems"
          Inputs="@(AclNativeSource)" Outputs="$(AclOutput)">
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)/Native&quot; -B &quot;$(MSBuildProjectDirectory)/obj/native/$(AclRid)&quot; $(AclArchitecture) -DCMAKE_BUILD_TYPE=Release" />
    <Exec Command="cmake --build &quot;$(MSBuildProjectDirectory)/obj/native/$(AclRid)&quot; --config Release --parallel 1" />
  </Target>
</Project>
