<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AclNativeName>libSomeEngineAcl.so</AclNativeName>
    <AclNativeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">SomeEngineAcl.dll</AclNativeName>
    <AclNativePath>$(MSBuildProjectDirectory)/obj/native/$(AclNativeName)</AclNativePath>
    <AclNativePath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProjectDirectory)/obj/native/Release/$(AclNativeName)</AclNativePath>
    <AclCmakeArchitecture>-DCMAKE_GENERATOR_PLATFORM=</AclCmakeArchitecture>
    <AclCmakeArchitecture Condition="$([MSBuild]::IsOSPlatform('Windows'))">-A x64</AclCmakeArchitecture>
    <AclBuildArguments Condition="$([MSBuild]::IsOSPlatform('Windows'))">-- /nodeReuse:false</AclBuildArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SomeEngine.Animation/SomeEngine.Animation.csproj" />
    <ProjectReference Include="../SomeEngine.Assets/SomeEngine.Assets.csproj" />
    <ProjectReference Include="../SomeEngine.Core/SomeEngine.Core.csproj" />
    <ProjectReference Include="../SomeEngine.Physics/SomeEngine.Physics.csproj" />
    <ProjectReference Include="../SomeEngine.Generators/SomeEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AclNativeSource Include="Native/**/*;../../external/acl/includes/**/*;../../external/rtm/includes/**/*" />
    <Content Include="$(AclNativePath)"
             Link="$(AclNativeName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" DependencyBinary="true" />
    <Content Include="../../external/acl/LICENSE" Link="licenses/ACL-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../external/rtm/LICENSE" Link="licenses/RTM-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildAclNative" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems"
          Inputs="@(AclNativeSource)" Outputs="$(AclNativePath)">
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)/Native&quot; -B &quot;$(MSBuildProjectDirectory)/obj/native&quot; $(AclCmakeArchitecture) -DCMAKE_BUILD_TYPE=Release" />
    <Exec Command="cmake --build &quot;$(MSBuildProjectDirectory)/obj/native&quot; --config Release --parallel 1 $(AclBuildArguments)" />
  </Target>
</Project>
