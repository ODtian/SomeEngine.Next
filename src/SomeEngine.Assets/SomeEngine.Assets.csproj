<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <DefineConstants>$(DefineConstants);SOMEENGINE_NATIVE_ASSET_CONTRACTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SomeEngine.Serialization\SomeEngine.Serialization.csproj" />
    <ProjectReference Include="..\SomeEngine.Generators\SomeEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
