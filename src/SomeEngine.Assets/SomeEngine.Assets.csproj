<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <DefineConstants>$(DefineConstants);SOMEENGINE_NATIVE_ASSET_CONTRACTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\Shaders\Inputs\*.slang-module">
      <LogicalName>SomeEngine.Assets.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SomeEngine.Core\SomeEngine.Core.csproj" />
    <ProjectReference Include="..\SomeEngine.Resources\SomeEngine.Resources.csproj" />
    <ProjectReference Include="..\SomeEngine.ECS\SomeEngine.ECS.csproj" />
    <ProjectReference Include="..\SomeEngine.ECS.Serialization\SomeEngine.ECS.Serialization.csproj" />
    <ProjectReference Include="..\SomeEngine.Serialization\SomeEngine.Serialization.csproj" />
    <ProjectReference Include="..\SomeEngine.Graphics\SomeEngine.Graphics.csproj" />
    <ProjectReference Include="..\SomeEngine.Generators\SomeEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
