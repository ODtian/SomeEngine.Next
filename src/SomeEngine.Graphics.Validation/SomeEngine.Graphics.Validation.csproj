<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Optional validation layer for the backend-neutral graphics receiver.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SlangShaderSharp" Version="$(SlangShaderSharpPackageVersion)" />
    <ProjectReference Include="../SomeEngine.Graphics/SomeEngine.Graphics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SomeEngine.Graphics.Direct3D12.Validation" />
  </ItemGroup>
</Project>
