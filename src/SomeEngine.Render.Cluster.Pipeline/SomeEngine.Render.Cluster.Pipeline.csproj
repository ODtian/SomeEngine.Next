<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SomeEngine.Generators\SomeEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SomeEngine.Assets\SomeEngine.Assets.csproj" />
    <ProjectReference Include="..\SomeEngine.ECS\SomeEngine.ECS.csproj" />
    <ProjectReference Include="..\SomeEngine.ECS.Systems\SomeEngine.ECS.Systems.csproj" />
    <ProjectReference Include="..\SomeEngine.Graphics\SomeEngine.Graphics.csproj" />
    <ProjectReference Include="..\SomeEngine.Render\SomeEngine.Render.csproj" />
    <ProjectReference Include="..\SomeEngine.Render.Cluster\SomeEngine.Render.Cluster.csproj" />
    <ProjectReference Include="..\..\external\Alimer.Bindings\src\Alimer.Bindings.MeshOptimizer\Alimer.Bindings.MeshOptimizer.csproj" />
    <ProjectReference Include="..\SomeEngine.RenderGraph\SomeEngine.RenderGraph.csproj" />
    <ProjectReference Include="..\..\external\SlangShaderSharp\src\SlangShaderSharp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\external\Alimer.Bindings\native\win-x64\meshoptimizer.dll" Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>meshoptimizer.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\win-arm64\meshoptimizer.dll" Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
      <Link>meshoptimizer.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\linux-x64\libmeshoptimizer.so" Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
      <Link>libmeshoptimizer.so</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\linux-arm64\libmeshoptimizer.so" Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
      <Link>libmeshoptimizer.so</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\Alimer.Bindings\native\osx\libmeshoptimizer.dylib" Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64' Or '$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">
      <Link>libmeshoptimizer.dylib</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
