  "Shaders": {
    "blend_effect_cells.slang": "#define BLEND_CELLS 1\n#include \"blend_effect_common.slang\"\nRWStructuredBuffer<uint2> CellMasks;\n\n[shader(\"compute\")]\n[numthreads(32, 1, 1)]\n[WaveSize(32)]\nvoid BuildBlendCells(uint3 group : SV_GroupID)\n{\n    uint wordIndex = group.x + group.y * 65535;\n    if (wordIndex >= Settings.WordCount) return;\n    uint lane = WaveGetLaneIndex();\n    uint2 word = Words[wordIndex];\n    float2 depth = 0;\n    if (lane < word.y) depth = Bounds[References[word.x + lane]].DepthRange;\n    float lower = SliceBoundary(lane), upper = SliceBoundary(lane + 1);\n    uint before = 0, after = 0;\n    for (uint bit = 0; bit < word.y; bit++)\n    {\n        float minimum = WaveReadLaneAt(depth.x, bit), maximum = WaveReadLaneAt(depth.y, bit);\n        if (minimum <= upper) before |= 1u << bit;\n        if (maximum >= lower) after |= 1u << bit;\n    }\n    CellMasks[wordIndex * Settings.DepthSlices + lane] = uint2(before, after);\n}\n",
    "blend_effect_resolve.slang": "#define BLEND_RESOLVE 1\n#include \"blend_effect_common.slang\"\nRWTexture2DArray<float4> SceneColor;\n#ifdef BLEND_CLUSTERED\nStructuredBuffer<uint2> CellMasks;\n#endif\ngroupshared uint MinimumDepth, MaximumDepth;\n\n[shader(\"compute\")]\n[numthreads(16, 16, 1)]\nvoid ResolveBlendEffect(uint3 group : SV_GroupID, uint3 thread : SV_GroupThreadID)\n{\n    uint lane = thread.y * 16 + thread.x;\n    uint2 pixel = group.xy * 16 + thread.xy;\n    bool valid = all(pixel < uint2(Settings.Width, Settings.Height));\n    float opaque = valid ? ViewDepth(OpaqueDepth.Load(int4(pixel, 0, 0))) : 0;\n#ifdef BLEND_CLUSTERED\n    if (lane == 0) { MinimumDepth = 0x7f7fffff; MaximumDepth = 0; }\n    GroupMemoryBarrierWithGroupSync();\n    float minimum = WaveActiveMin(valid ? opaque : 3.402823e38);\n#ifdef BLEND_XRAY\n    float maximum = WaveActiveMax(valid ? opaque + Settings.XrayDistance : 0);\n#else\n    float maximum = WaveActiveMax(valid ? opaque : 0);\n#endif\n    if (WaveIsFirstLane())\n    {\n        uint ignored;\n        InterlockedMin(MinimumDepth, asuint(minimum), ignored);\n        InterlockedMax(MaximumDepth, asuint(maximum), ignored);\n    }\n    GroupMemoryBarrierWithGroupSync();\n    uint lower = DepthSlice(asfloat(MinimumDepth)), upper = DepthSlice(asfloat(MaximumDepth));\n#endif\n    float2 point = BlendPixelPoint(pixel);\n    float4 color = valid ? SceneColor[uint3(pixel, 0)] : 0;\n    uint2 tile = TileWords[group.y * Settings.TileColumns + group.x];\n    for (uint wordIndex = tile.x; wordIndex < tile.x + tile.y; wordIndex++)\n    {\n        uint2 word = Words[wordIndex];\n#ifdef BLEND_CLUSTERED\n        uint bits = CellMasks[wordIndex * Settings.DepthSlices + upper].x &\n            CellMasks[wordIndex * Settings.DepthSlices + lower].y;\n#else\n        uint bits = 0xffffffffu >> (32 - word.y);\n#endif\n        while (bits != 0)\n        {\n            uint bit = firstbitlow(bits);\n            bits &= bits - 1;\n            uint index = References[word.x + bit];\n            float4 surface = 0;\n#ifdef BLEND_XRAY\n            ProjectedTriangle coverage = Coverage[index];\n            float depth;\n            if (valid && Covers(coverage, point, depth) && depth > opaque && depth <= opaque + Settings.XrayDistance)\n            {\n                float3 bary = float3(dot(coverage.EdgeA.xyz, float3(point, 1)),\n                    dot(coverage.EdgeB.xyz, float3(point, 1)), dot(coverage.EdgeC.xyz, float3(point, 1)));\n                BlendTriangle triangle = Triangles[index];\n                float3 normal = triangle.A.Normal * bary.x + triangle.B.Normal * bary.y + triangle.C.Normal * bary.z;\n                float2 uv = float2(triangle.A.U, triangle.A.V) * bary.x + float2(triangle.B.U, triangle.B.V) * bary.y +\n                    float2(triangle.C.U, triangle.C.V) * bary.z;\n                surface = ShadeXray(normal, uv, Bounds[index].MaterialIndex, depth, opaque);\n            }\n#else\n            if (valid) surface = ShadeDecal(index, point, opaque);\n#endif\n            color.rgb = surface.rgb + (1 - surface.a) * color.rgb;\n            color.rgb = f16tof32(f32tof16(color.rgb));\n        }\n    }\n    if (valid) SceneColor[uint3(pixel, 0)] = color;\n}\n"
