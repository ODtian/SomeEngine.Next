<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SomeEngine.Typography/SomeEngine.Typography.csproj"
                      GlobalPropertiesToRemove="PublishAot" />
    <Content Include="../../tests/SomeEngine.Typography.Tests/Fonts/Cjk.otf;../../tests/SomeEngine.Typography.Tests/Fonts/Latin.ttf;../../tests/SomeEngine.Typography.Tests/Fonts/OFL-*.txt"
             Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
