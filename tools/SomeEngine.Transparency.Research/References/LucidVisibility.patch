+Ex<> LucidRenderer::renderCached(const Context &ctx) {
+    auto &commands = ctx.device.cmdQueue();
+    commands.fullBarrier();
+    uint first = offsetof(shader::LucidInfo, a_small_bins) / sizeof(u32);
+    commands.fill(m_info.subSpan(first, first + 2), 0);
+    commands.barrier(VPipeStage::transfer, VPipeStage::compute_shader,
+        VAccess::transfer_write, VAccess::shader_read | VAccess::shader_write);
+    rasterLow(ctx);
+    rasterHigh(ctx);
+    return {};
+}
+u64 LucidRenderer::transparencyBytes() const {
+    u64 bytes = m_bin_quads.byteSize() + m_bin_tris.byteSize() + m_normals_storage.byteSize() +
+        m_uvec4_storage.byteSize() + m_scratch_32.byteSize() + m_scratch_64.byteSize();
+    for(int index = 0; index < num_frames; index++)
+        bytes += m_frame_instance_data[index].byteSize() + m_frame_info[index].byteSize() + m_frame_config[index].byteSize();
+    return bytes;
+}
