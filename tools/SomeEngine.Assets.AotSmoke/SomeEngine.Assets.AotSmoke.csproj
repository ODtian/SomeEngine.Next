<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <Content Include="../../samples/DefaultGame/assets/Shaders/triangle.shader.asset" Link="Fixtures/triangle.shader.asset" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../../samples/SomeEngine.Curves.Assets/SomeEngine.Curves.Assets.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="..\..\src\SomeEngine.Assets\SomeEngine.Assets.csproj"
                      GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="..\..\src\SomeEngine.Generators\SomeEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="SomeEngine.Resources" />
    <Using Include="SomeEngine.Assets.Schema" />
  </ItemGroup>
</Project>
