<Project TreatAsLocalProperty="SlangToolchainVersion">
  <PropertyGroup>
    <SomeEngineRepositoryRoot>$(MSBuildThisFileDirectory)</SomeEngineRepositoryRoot>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);SomeEngine.Views.Generated</InterceptorsNamespaces>
    <_RequestedSlangToolchainVersion>$(SlangToolchainVersion)</_RequestedSlangToolchainVersion>
    <SlangToolchainVersion>2026.17.1</SlangToolchainVersion>
    <SlangShaderSharpPackageVersion>2026.17.1</SlangShaderSharpPackageVersion>
    <SlangStandardModuleDirectory>slang-standard-module-$(SlangToolchainVersion)</SlangStandardModuleDirectory>
    <SlangTestFixtureDirectory>SlangStandardModule$(SlangToolchainVersion)</SlangTestFixtureDirectory>
  </PropertyGroup>
</Project>
