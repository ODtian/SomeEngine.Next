<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SomeEngine.RenderGraph/SomeEngine.RenderGraph.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Graphics.Null/SomeEngine.Graphics.Null.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Graphics.Direct3D12/SomeEngine.Graphics.Direct3D12.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Assets/SomeEngine.Assets.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Render/SomeEngine.Render.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Generators/SomeEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="New/**/*.cs" />
    <None Include="../../assets/Shaders/hello_triangle.shader.asset"
          Link="Content/Shaders/hello_triangle.shader.asset"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../external/dxc/bin/x64/dxcompiler.dll">
      <Link>dxcompiler.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/dxc/bin/x64/dxil.dll">
      <Link>dxil.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
