<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SlangShaderSharp" Version="$(SlangShaderSharpPackageVersion)" />
    <ProjectReference Include="../../src/SomeEngine.Assets/SomeEngine.Assets.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Assets.Importers/SomeEngine.Assets.Importers.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Graphics.Direct3D12\SomeEngine.Graphics.Direct3D12.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Graphics.Validation\SomeEngine.Graphics.Validation.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Graphics.Vulkan\SomeEngine.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Render.Cluster\SomeEngine.Render.Cluster.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Render.Cluster.Pipeline\SomeEngine.Render.Cluster.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Render.Features\SomeEngine.Render.Features.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.RenderGraph\SomeEngine.RenderGraph.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Serialization\SomeEngine.Serialization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\external\dxc\bin\x64\dxcompiler.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>dxcompiler.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\dxc\bin\x64\dxil.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>dxil.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SomeEngine.Resources/SomeEngine.Resources.csproj" />
    <Using Include="SomeEngine.Resources" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SomeEngine.Generators/SomeEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
