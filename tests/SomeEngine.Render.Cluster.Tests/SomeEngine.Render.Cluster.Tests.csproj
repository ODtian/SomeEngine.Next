<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\external\SlangShaderSharp\src\SlangShaderSharp.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Assets.Importers/SomeEngine.Assets.Importers.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Graphics.Direct3D12\SomeEngine.Graphics.Direct3D12.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Graphics.Validation\SomeEngine.Graphics.Validation.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Graphics.Vulkan\SomeEngine.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Render.Cluster\SomeEngine.Render.Cluster.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Render.Cluster.Pipeline\SomeEngine.Render.Cluster.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Render.Features\SomeEngine.Render.Features.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.RenderGraph\SomeEngine.RenderGraph.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Serialization\SomeEngine.Serialization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\external\SlangShaderSharp\runtimes\**">
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\win-x64\native\slang-compiler.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>slang-compiler.dll</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\win-arm64\native\slang-compiler.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
      <Link>slang-compiler.dll</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\linux-x64\native\libslang-compiler.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
      <Link>libslang-compiler.so</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\linux-arm64\native\libslang-compiler.so"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
      <Link>libslang-compiler.so</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\osx-x64\native\libslang-compiler.dylib"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">
      <Link>libslang-compiler.dylib</Link>
    </Content>
    <Content Update="..\..\external\SlangShaderSharp\runtimes\osx-arm64\native\libslang-compiler.dylib"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">
      <Link>libslang-compiler.dylib</Link>
    </Content>
    <Content Include="..\..\external\dxc\bin\x64\dxcompiler.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>dxcompiler.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\external\dxc\bin\x64\dxil.dll"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>dxil.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\templates\DefaultProject\assets\Shaders\hello_triangle.shader.asset">
      <Link>Content\Shaders\hello_triangle.shader.asset</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\templates\DefaultProject\assets\Shaders\standard.shader.asset">
      <Link>Content\Shaders\standard.shader.asset</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\templates\DefaultProject\assets\Shaders\unlit.shader.asset">
      <Link>Content\Shaders\unlit.shader.asset</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../templates/DefaultProject/Game/Game.csproj" />
    <Using Include="Game.Content" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SomeEngine.Generators/SomeEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
