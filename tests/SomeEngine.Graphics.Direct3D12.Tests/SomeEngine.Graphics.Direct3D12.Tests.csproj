<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SlangStandardModuleSourceRoot>$(MSBuildThisFileDirectory)..\..\external\SlangShaderSharp\standard-modules</SlangStandardModuleSourceRoot>
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">(Isolation!=ProcessDestructive)&amp;(Isolation!=PresentationProcess)&amp;(Isolation!=DeviceLossProcess)</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SomeEngine.Graphics.Direct3D12/SomeEngine.Graphics.Direct3D12.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Graphics.Validation/SomeEngine.Graphics.Validation.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Assets/SomeEngine.Assets.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Assets.Importers/SomeEngine.Assets.Importers.csproj" />
    <ProjectReference Include="../../src/SomeEngine.RenderGraph/SomeEngine.RenderGraph.csproj" />
    <ProjectReference Include="../../src/SomeEngine.Generators/SomeEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures/*.dxil" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../external/dxc/bin/x64/dxcompiler.dll">
      <Link>dxcompiler.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/dxc/bin/x64/dxil.dll">
      <Link>dxil.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/SlangShaderSharp/runtimes/win-x64/native/slang-compiler.dll">
      <Link>slang-compiler.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/SlangShaderSharp/runtimes/win-x64/native/slang-glslang.dll">
      <Link>slang-glslang.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(SlangStandardModuleSourceRoot)/experimental/workgraph.slang">
      <Link>$(SlangStandardModuleDirectory)/experimental/workgraph.slang</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="$(SlangStandardModuleSourceRoot)/experimental/workgraph.slang-module">
      <Link>$(SlangStandardModuleDirectory)/experimental/workgraph.slang-module</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="$(SlangStandardModuleSourceRoot)/LICENSE">
      <Link>$(SlangStandardModuleDirectory)/LICENSE</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ValidateSlangTestFixture" BeforeTargets="PrepareForBuild"
          DependsOnTargets="ValidateSlangToolchainIdentity">
    <Error Condition="!Exists('$(SlangStandardModuleSourceRoot)/experimental/workgraph.slang')"
           Text="The Slang fixture does not match SlangToolchainVersion $(SlangToolchainVersion)." />
    <Error Condition="!Exists('$(SlangStandardModuleSourceRoot)/experimental/workgraph.slang-module')"
           Text="The Slang fixture module does not match SlangToolchainVersion $(SlangToolchainVersion)." />
    <Error Condition="!Exists('$(SlangStandardModuleSourceRoot)/LICENSE')"
           Text="The Slang fixture license does not match SlangToolchainVersion $(SlangToolchainVersion)." />
  </Target>
</Project>
