<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/SomeEngine.Transparency.Research/SomeEngine.Transparency.Research.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Render\SomeEngine.Render.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.RenderGraph\SomeEngine.RenderGraph.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Job\SomeEngine.Job.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Graphics.Direct3D12\SomeEngine.Graphics.Direct3D12.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Serialization\SomeEngine.Serialization.csproj" />
    <ProjectReference Include="..\..\src\SomeEngine.Generators\SomeEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\templates\DefaultProject\assets\Shaders\hello_triangle.shader.asset">
      <Link>Content\Shaders\hello_triangle.shader.asset</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\templates\DefaultProject\assets\Shaders\vsm_frame_reset.shader.asset">
      <Link>Content\Shaders\vsm_frame_reset.shader.asset</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../templates/DefaultProject/Game.Assets/Game.Assets.csproj" />
    <Using Include="Game.Content" />
    <Using Include="Game.Assets" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../templates/DefaultProject/Game.Assets/Game.Assets.csproj" />
    <Using Include="Game.Content" />
    <Using Include="Game.Assets" />
  </ItemGroup>
</Project>
