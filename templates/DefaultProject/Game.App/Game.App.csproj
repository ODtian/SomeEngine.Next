<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="PublishWithSatoriGC" Version="10.0.13-satori.38062657141.1" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ProjectContentRoot Condition="'$(ProjectContentRoot)' == ''">$(DefaultProjectDirectory)</ProjectContentRoot>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <PublishAotUsingRuntimePack Condition="'$(Configuration)' == 'Release'">true</PublishAotUsingRuntimePack>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <DefineConstants Condition="'$(PublishAot)' != 'true'">$(DefineConstants);GAME_MANAGED_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Game.Assets/Game.Assets.csproj" />
    <ProjectReference Include="$(SomeEnginePath)/samples/ImportedScenes/Materials/ImportedScenes.Materials.csproj" />
    <ProjectReference Include="$(SomeEnginePath)/src/SomeEngine.Runtime/SomeEngine.Runtime.csproj" />
    <Content Include="$(ProjectContentRoot)/assets/**/*.asset" Link="assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ProjectContentRoot)/Library/AssetManifest/**/*" Link="Library/AssetManifest/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(SomeEnginePath)/external/dxc/bin/x64/dxcompiler.dll;$(SomeEnginePath)/external/dxc/bin/x64/dxil.dll" DependencyBinary="true"
             Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SomeEnginePath)/src/SomeEngine.Generators/SomeEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="WriteTestScenes" AfterTargets="Build">
    <PropertyGroup>
      <_TestSceneDirectory>$([System.String]::Copy('$(SomeEnginePath)/samples/ImportedScenes/Apps').Replace('\', '/'))</_TestSceneDirectory>
      <_TestScenes>[{&quot;Name&quot;:&quot;1024 spheres&quot;,&quot;ContentDirectory&quot;:&quot;.&quot;,&quot;Animate&quot;:true},{&quot;Name&quot;:&quot;Sponza&quot;,&quot;ContentDirectory&quot;:&quot;$(_TestSceneDirectory)/Sponza&quot;},{&quot;Name&quot;:&quot;Amazon Bistro&quot;,&quot;ContentDirectory&quot;:&quot;$(_TestSceneDirectory)/Bistro&quot;}]</_TestScenes>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)test-scenes.json" Lines="$(_TestScenes)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="PublishTestScenes" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)test-scenes.json" RelativePath="test-scenes.json" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="CompileReleaseApplication" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(PublishAot)' == 'true' and '$(NoBuild)' != 'true' and '$(_IsPublishing)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish"
             Properties="NoBuild=true;_IsPublishing=true;PublishDir=$(TargetDir)publish/" />
  </Target>
</Project>
