<Project>
  <Import Project="$(MSBuildThisFileDirectory)EnginePath.props" Condition="Exists('$(MSBuildThisFileDirectory)EnginePath.props')" />
  <PropertyGroup>
    <SomeEnginePath Condition="'$(SomeEnginePath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</SomeEnginePath>
    <SomeEnginePath>$([System.IO.Path]::GetFullPath('$(SomeEnginePath)', '$(MSBuildThisFileDirectory)'))</SomeEnginePath>
    <DefaultProjectDirectory>$(MSBuildThisFileDirectory)</DefaultProjectDirectory>
  </PropertyGroup>
  <Import Project="$(SomeEnginePath)/Directory.Build.props" />
</Project>
